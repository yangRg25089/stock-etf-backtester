{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "noEmit": false,
    "noEmitOnError": true,
    "module": "CommonJS",
    "moduleResolution": "Node",
    "rootDir": "src",
    "outDir": ".test-output",
    "tsBuildInfoFile": "./.test-output/tsconfig.tsbuildinfo"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules", ".test-output"]
}
