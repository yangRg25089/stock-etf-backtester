  "explicitDifferences": [
    {
      "topic": "price_basis",
      "source": "Both notebooks request yfinance auto_adjust=False and use Adj Close/Close fallback.",
      "v1": "The normalized contract keeps simulationPrice and valuationPrice separate; PE never substitutes one for the other."
    },
    {
      "topic": "vix_missing_values",
      "source": "Both notebooks forward-fill VIX values.",
      "v1": "Missing observations remain unavailable; no forward fill or silent skip."
    },
    {
      "topic": "contribution_calendar",
      "source": "Both notebooks hard-code today.day <= 7 and one contribution per month.",
      "v1": "contribution.day is 1..31; holidays roll within the same month and month-incomplete ranges do not backfill or prepay."
    },
    {
      "topic": "signal_timing",
      "source": "Notebook signals execute on the same close.",
      "v1": "A close signal executes on the next trading day; a final-day signal is recorded as unexecuted."
    },
    {
      "topic": "month_end",
      "source": "Notebook month-end and final-day safety checks are implementation shortcuts.",
      "v1": "The exchange calendar determines actual month end; a truncated final day is not treated as month end."
    },
    {
      "topic": "primary_sources",
      "source": "The design cites qqq_vix_dca and compare_strategies.",
      "v1": "The copy notebook is retained only as non-normative provenance because its dates, VIX threshold, and SPY legend differ."
    },
    {
      "topic": "hardcoded_fields",
      "source": "compare_strategies hard-codes Bollinger sell VIX ceiling 20 and grid lists.",
      "v1": "They are explicit registered fields/search dimensions, with maxCombinations capped at 1000 by default and 10000 hard."
    },
    {
      "topic": "point_in_time",
      "source": "The notebooks do not model public disclosure timing, ETF holdings, or PE coverage.",
      "v1": "Fixtures and later adapters preserve as-of dates, missing PE, split bases, and ETF coverage diagnostics."
    }
  ],
